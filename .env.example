# Google AI Studio (https://aistudio.google.com/apikey)
GOOGLE_API_KEY=incolla-qui-la-tua-chiave
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Anthropic (https://console.anthropic.com): serve solo se un modello "claude-..." è nella catena
ANTHROPIC_API_KEY=incolla-qui-la-tua-chiave

# Modello: cambialo qui senza toccare il codice (gemini-2.5-flash non è più disponibile ai nuovi utenti)
AGENT_MODEL=gemini-3.5-flash-lite
# Riserve in ordine, separate da virgola: usate se il principale dà 429/5xx/timeout.
# I nomi "claude-..." usano l'API Anthropic (ANTHROPIC_API_KEY), gli altri Gemini.
AGENT_FALLBACK_MODELS=gemini-3.1-flash-lite,claude-opus-5-5
# Tentativi per modello, con backoff esponenziale (1 = nessun retry, si passa subito alla riserva)
AGENT_RETRY_ATTEMPTS=1
# Secondi massimi per richiesta: un modello sovraccarico può metterci minuti a rispondere 503
AGENT_TIMEOUT_S=15
# Dopo un fallimento, per quanti secondi saltare il principale e usare direttamente la riserva
AGENT_PRIMARY_COOLDOWN_S=300

# URL del backend usato dalla UI Streamlit
API_URL=http://127.0.0.1:8000
